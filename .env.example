# ─────────────────────────────────────────────────────────────────────────────
# «Магия» — переменные окружения. Скопируйте файл в .env.local и заполните.
# Обязательный минимум для локального запуска:
#   ORDER_ACCESS_SECRET=<случайная строка не короче 32 символов>
# ─────────────────────────────────────────────────────────────────────────────

# Окружение: development | test | production.
# Если не задано, определяется по NODE_ENV.
APP_ENV=development

# Публичный адрес приложения (без слэша на конце).
# В production обязателен https.
APP_URL=http://localhost:3000

# Секрет для подписи и шифрования гостевых ссылок на заказ.
# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ORDER_ACCESS_SECRET=

# Цена книги в рублях (используется в интерфейсе и при проверке платежа).
PRODUCT_PRICE_RUB=499

# ── Генерация ────────────────────────────────────────────────────────────────
# Демо-режим: сказки и иллюстрации создаются локально, без обращения к AI-API.
# Разрешён только вне production. Демо-заказы навсегда помечаются «ДЕМО-ВЕРСИЯ».
DEMO_MODE=false

# Сколько раз разрешено повторить генерацию без повторной оплаты.
GENERATION_MAX_ATTEMPTS=3

# Обработка задач генерации внутри веб-процесса (удобно для локальной разработки).
# В production используйте /api/cron/worker или scripts/worker.ts и задайте false.
INLINE_WORKER=true

# Секрет для вызова /api/cron/worker (заголовок x-cron-secret или Authorization: Bearer).
CRON_SECRET=

# ── Текстовый AI-провайдер (OpenAI-совместимый API) ──────────────────────────
# Если DEMO_MODE=false, эти переменные обязательны: иначе создание заказов отключено.
AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_TEXT_TIMEOUT_MS=90000

# ── Иллюстрации ──────────────────────────────────────────────────────────────
# local — собственный векторный иллюстратор (работает без интернета);
# openai — OpenAI-совместимый image API.
IMAGE_PROVIDER=local
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_TIMEOUT_MS=120000

# ── Оплата ───────────────────────────────────────────────────────────────────
# test — только для разработки (запрещён в production);
# yookassa — реальные платежи, статус подтверждается на сервере через API.
PAYMENT_PROVIDER=test

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть покупателя после оплаты (обычно https://<домен>/pay/<orderId>).
YOOKASSA_RETURN_URL=

# ── Письма ───────────────────────────────────────────────────────────────────
# outbox — письма складываются в data/outbox (разработка);
# resend — реальная отправка через Resend;
# disabled — отправка выключена.
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=Магия <hello@example.com>

# ── Данные ───────────────────────────────────────────────────────────────────
# Локальное хранилище используется, если не заданы SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY.
ORDER_DATA_DIR=data
LOCAL_STORAGE_DIR=data/storage

# ── Supabase (production) ────────────────────────────────────────────────────
# Заполните оба значения, чтобы переключиться на PostgreSQL + private Storage.
# Применение схемы: supabase/migrations/0001_init.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=magia-private

# ── Прочее ───────────────────────────────────────────────────────────────────
# Адрес поддержки, отображается в интерфейсе и письмах.
SUPPORT_EMAIL=support@magia.example
